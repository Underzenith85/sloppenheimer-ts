{
  "name": "symphony-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A strict TypeScript implementation of the OpenAI Symphony service specification",
  "bin": {
    "symphony": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "chokidar": "5.0.0",
    "effect": "3.22.1",
    "liquidjs": "10.29.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "fast-check": "4.9.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
