{
  "name": "sloppenheimer-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A strict TypeScript implementation of the OpenAI Symphony service specification",
  "bin": {
    "sloppenheimer": "./dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc -p tsconfig.browser.json && node scripts/copy-operator-ui.mjs && pnpm --filter @sloppenheimer/coordinator-ui build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx src/cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:conformance": "vitest run --config vitest.conformance.config.ts",
    "test:real-integration": "vitest run --config vitest.real-integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit && pnpm --filter @sloppenheimer/coordinator-ui typecheck && tsc -p test/coordinator-ui/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@sloppenheimer/adapter-codex": "workspace:*",
    "@sloppenheimer/adapter-github": "workspace:*",
    "@sloppenheimer/adapter-node": "workspace:*",
    "@sloppenheimer/core": "workspace:*",
    "chokidar": "5.0.0",
    "effect": "3.22.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@effect/vitest": "0.30.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "fast-check": "4.9.0",
    "happy-dom": "20.0.11",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
