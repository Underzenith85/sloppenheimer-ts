{
  "name": "@sloppenheimer/adapter-github",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub tracker, issue-control, code-review, and source-control implementations.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@sloppenheimer/adapter-node": "workspace:*",
    "@sloppenheimer/core": "workspace:*",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
