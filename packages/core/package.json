{
  "name": "@sloppenheimer/core",
  "version": "0.1.0",
  "private": true,
  "description": "Domain types, ports, and orchestration policy. Depends on no adapter.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "effect": "3.22.1",
    "liquidjs": "10.29.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
