{
  "name": "@sloppenheimer/coordinator-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe coordinator wire schemas, pure policies and reusable fixtures.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
