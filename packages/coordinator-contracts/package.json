      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
